{
  "name": "twinflow-server",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "build:client": "npm --prefix ../client run build",
    "deploy": "npm --prefix ../client run build && wrangler deploy --minify",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply twinflow-d1 --local",
    "db:migrate:remote": "wrangler d1 migrations apply twinflow-d1 --remote",
    "db:seed": "wrangler d1 execute twinflow-d1 --local --file=./drizzle/seed.sql",
    "db:seed:remote": "wrangler d1 execute twinflow-d1 --remote --file=./drizzle/seed.sql",
    "db:setup": "wrangler d1 migrations apply twinflow-d1 --local && wrangler d1 execute twinflow-d1 --local --file=./drizzle/seed.sql",
    "db:setup:remote": "wrangler d1 migrations apply twinflow-d1 --remote && wrangler d1 execute twinflow-d1 --remote --file=./drizzle/seed.sql",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.38.3",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "drizzle-kit": "^0.30.1",
    "typescript": "^5.7.2",
    "wrangler": "^3.101.0"
  }
}
